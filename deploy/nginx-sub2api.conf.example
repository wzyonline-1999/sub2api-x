# Put this directive in the nginx http {} block, not only inside server {}.
# Codex/OpenAI-compatible clients may send headers containing underscores.
underscores_in_headers on;

# Put this map in the nginx http {} block as well.
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 443 ssl http2;
    server_name your-domain.example;

    # ssl_certificate     /path/to/fullchain.pem;
    # ssl_certificate_key /path/to/privkey.pem;

    client_max_body_size 256m;

    location = /sub2api {
        return 301 /sub2api/;
    }

    location /sub2api/ {
        # No trailing slash here: keep /sub2api/... in the upstream request URI.
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Backend is configured with SERVER_BASE_PATH=/sub2api, so redirects and
        # browser routes are generated under the same prefix.

        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
