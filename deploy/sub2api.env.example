# Frontend is built to live below this path.
VITE_APP_BASE_PATH=/sub2api/
VITE_API_BASE_URL=/sub2api/api/v1
VITE_WS_BASE_URL=

# Sub2API listens only on the VPS loopback address. Nginx exposes it.
SERVER_HOST=127.0.0.1
SERVER_PORT=18080
SERVER_MODE=release
# Backend routes are mounted below this path, so Nginx can forward /sub2api/*
# without stripping the prefix.
SERVER_BASE_PATH=/sub2api
RUN_MODE=standard
TZ=Asia/Shanghai

# Supabase PostgreSQL.
# Prefer the Supabase Session Pooler host/port for a long-running VPS service.
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_DBNAME=postgres
DATABASE_SSLMODE=require
# Keep Sub2API tables isolated from other projects in the same Supabase database.
DATABASE_SCHEMA=sub2api
DATABASE_MAX_OPEN_CONNS=5
DATABASE_MAX_IDLE_CONNS=2
DATABASE_CONN_MAX_LIFETIME_MINUTES=30
DATABASE_CONN_MAX_IDLE_TIME_MINUTES=5

# Redis is installed directly on the VPS host.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=32
REDIS_MIN_IDLE_CONNS=2
REDIS_ENABLE_TLS=false

ADMIN_EMAIL=admin@sub2api.local
ADMIN_PASSWORD=

# Generate with:
#   openssl rand -hex 32
JWT_SECRET=
TOTP_ENCRYPTION_KEY=

JWT_EXPIRE_HOUR=24

GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=
GEMINI_OAUTH_SCOPES=
GEMINI_QUOTA_POLICY=
GEMINI_CLI_OAUTH_CLIENT_SECRET=
ANTIGRAVITY_OAUTH_CLIENT_SECRET=
